# Copy to .env and adjust. Real environment variables override this file.

# Network
ROTA_HOST=0.0.0.0
ROTA_PORT=8080          # PORT (set by most PaaS hosts) takes precedence

# Limits
ROTA_MAX_UNITS=5000     # largest rota accepted: sum over all shifts of "needs"
ROTA_MAX_BODY_KB=256    # largest request body
ROTA_RATE_LIMIT=120     # API requests per client per minute; 0 disables

# Comma-separated origins allowed to call the API from a browser, or * for any.
# Empty = same-origin only (the bundled playground needs nothing here).
ROTA_CORS_ORIGINS=

# Serve the web playground at / (false = API only)
ROTA_SERVE_WEB=true

# TRACE, DEBUG, INFO, WARN or ERROR
ROTA_LOG_LEVEL=INFO
